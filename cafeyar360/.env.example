# Values can be set in the shell; manage.py init asks missing passwords privately in an interactive terminal. Files named .env are NOT auto-loaded.
# Explicitly set DEMO_MODE=1 only for synthetic sample data; it NEVER supplies default passwords.
DEMO_MODE=0
CAFE_DB_PATH=cafe_nima.sqlite3
PUBLIC_BASE_URL=http://192.168.1.20:8000
# 0 for trusted local HTTP, 1 when using HTTPS (HTTP logins then will not persist).
COOKIE_SECURE=0
# Required (12+ characters each) for ALL NEW databases (demo included); set privately in shell.
CAFE_PASSWORD_ADMIN=
CAFE_PASSWORD_CASHIER=
CAFE_PASSWORD_BARISTA=
# Optional. Read only from environment; never store a real token in this file.
TELEGRAM_BOT_TOKEN=

# Accounting and receipt civil time is fixed to Asia/Tehran; tzdata supports Windows.
# Product: Cafe Yar 360. Sample cafe: Cafe Nima. Default DB filename is unchanged.
