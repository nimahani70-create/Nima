# These values must be set in the shell. Files named .env are NOT auto-loaded.
# Explicitly set DEMO_MODE=1 only for synthetic sample data and public demo passwords.
DEMO_MODE=0
CAFE_DB_PATH=cafe_nima.sqlite3
PUBLIC_BASE_URL=http://192.168.1.20:8000
# 0 for trusted local HTTP, 1 when using HTTPS (HTTP logins then will not persist).
COOKIE_SECURE=0
# Required (12+ characters each) for NEW non-demo databases; set privately in shell.
CAFE_PASSWORD_ADMIN=
CAFE_PASSWORD_CASHIER=
CAFE_PASSWORD_BARISTA=
# Optional. Read only from environment; never store a real token in this file.
TELEGRAM_BOT_TOKEN=
